{
  "name": "@openlab/protocol",
  "version": "2.0.0",
  "description": "OpenLab TypeScript SDK for the Uni-Lab-OS backend: typed API clients, error handling, operation catalog and OpenAPI definitions.",
  "keywords": [
    "openlab",
    "uni-lab-os",
    "unilabos",
    "laboratory-automation",
    "edge",
    "api-client",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/Xuwznln/OpenLabSite/tree/main/packages/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuwznln/OpenLabSite.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/Xuwznln/OpenLabSite/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "openapi",
    "CHANGELOG.md",
    "README.en.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./openapi": {
      "types": "./dist/generated/openapi.d.ts",
      "import": "./dist/generated/openapi.js"
    },
    "./openapi.json": "./openapi/unilabos-openapi.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check": "pnpm run build && node scripts/validate-contract.mjs",
    "test": "vitest run",
    "smoke": "node scripts/live-smoke.mjs",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:types": "node scripts/sync-openapi.mjs --types-only",
    "prepack": "pnpm run check && pnpm run test"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
