{
  "name": "openlab",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first laboratory operations interface for OpenLab-compatible Edge runtimes",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm run protocol:build && vite",
    "build": "pnpm run protocol:check && pnpm run protocol:test && pnpm run app:build",
    "app:build": "vue-tsc -b && vite build",
    "app:test": "vitest run",
    "protocol:build": "pnpm --filter @openlab/protocol build",
    "protocol:check": "pnpm --filter @openlab/protocol check",
    "preview": "vite preview",
    "protocol:test": "pnpm --filter @openlab/protocol test"
  },
  "dependencies": {
    "@openlab/protocol": "workspace:*",
    "@dagrejs/dagre": "^3.0.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "naive-ui": "^2.44.1",
    "pinia": "^4.0.2",
    "read-excel-file": "^9.3.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}